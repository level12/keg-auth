msgstr "¡No se configuró KEGAUTH_LDAP_SERVER_URL!"

#: src/keg_auth/libs/authenticators.py:1098
msgid "No KEGAUTH_LDAP_DN_FORMAT configured!"
msgstr "¡No se configuró KEGAUTH_LDAP_DN_FORMAT!"

